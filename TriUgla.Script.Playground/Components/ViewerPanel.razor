<section class="viewer-panel dock-panel" data-panel-id="viewer" data-panel-title="3D View" aria-labelledby="viewer-title">
    <div class="panel-bar viewer-bar">
        <div><h2 id="viewer-title">3D view</h2><span class="camera-label">Orthographic orbit camera</span></div>
        <div class="viewer-actions">
            <button type="button" onclick="meshViewer.fit()" aria-label="Fit mesh in view">Fit</button>
            <button type="button" onclick="meshViewer.reset()" aria-label="Reset camera">Reset</button>
        </div>
    </div>
    <div class="viewer-surface">
        <canvas id="mesh-viewer" tabindex="0" aria-label="Orthographic 3D mesh view. Drag to rotate, Shift-drag to pan, and scroll to zoom."></canvas>
        <div class="viewer-help" aria-hidden="true">Drag rotate · Shift/right drag pan · Scroll zoom</div>
    </div>
</section>
