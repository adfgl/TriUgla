<section class="viewer-panel" aria-label="Mesh viewer">
    <div class="panel-bar viewer-bar">
        <div class="editor-command-group viewer-actions" role="toolbar" aria-label="Mesh viewer commands">
            <button class="editor-command-button text-command viewer-command-button" type="button"
                    onclick="meshViewer.fit()" title="Fit mesh in view" aria-label="Fit mesh in view">Fit</button>
            <button class="editor-command-button text-command viewer-command-button" type="button"
                    onclick="meshViewer.reset()" title="Reset camera" aria-label="Reset camera">Reset</button>
        </div>
    </div>
    <div class="viewer-surface">
        <canvas id="mesh-viewer" tabindex="0" aria-label="Orthographic 3D mesh view. Use the pointer to rotate, Shift or the right pointer button to pan, and scroll to zoom."></canvas>
        <div class="mesh-legend" role="group" aria-label="Toggle mesh face types">
            <button type="button" data-face-kind="Island" aria-pressed="true"
                    onclick="meshViewer.toggleFaceKind('Island')" title="Show or hide island triangles">
                <i class="face-island" aria-hidden="true"></i>Island
            </button>
            <button type="button" data-face-kind="Lake" aria-pressed="true"
                    onclick="meshViewer.toggleFaceKind('Lake')" title="Show or hide lake triangles">
                <i class="face-lake" aria-hidden="true"></i>Lake
            </button>
            <button type="button" data-face-kind="Outside" aria-pressed="true"
                    onclick="meshViewer.toggleFaceKind('Outside')" title="Show or hide outside triangles">
                <i class="face-outside" aria-hidden="true"></i>Outside
            </button>
        </div>
    </div>
</section>
