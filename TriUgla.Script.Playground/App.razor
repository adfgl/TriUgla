<HeadContent>
    <title>TriUgla Script Playground</title>
    <meta name="description" content="Write and validate TriUgla scripts in your browser." />
</HeadContent>

<ErrorBoundary>
    <ChildContent>
        <Router AppAssembly="typeof(App).Assembly">
            <Found Context="routeData">
                <RouteView RouteData="routeData" />
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </Found>
            <NotFound>
                <main class="not-found">
                    <h1>Page not found</h1>
                    <a href="/">Return to the playground</a>
                </main>
            </NotFound>
        </Router>
    </ChildContent>
    <ErrorContent Context="exception">
        <main class="startup-error" role="alert">
            <h1>TriUgla could not start</h1>
            <p>@exception.Message</p>
            <button type="button" onclick="location.reload()">Reload application</button>
        </main>
    </ErrorContent>
</ErrorBoundary>
