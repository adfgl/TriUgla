@page "/"
@inject IJSRuntime JS
@implements IDisposable

<main class="workspace">
    <header class="app-header">
        <div>
            <p class="eyebrow">TriUgla / browser playground</p>
            <h1>Script editor</h1>
        </div>
    </header>

    <div class="workspace-layout" aria-label="Script and mesh workspace">
        <div class="workspace-column workspace-left">
            <EditorPanel Model="editor" FileName="@scriptFileName" IsRunning="isRunning" HasRun="hasRun" Status="@runStatus"
                         ElapsedText="@ElapsedText" RunRequested="HandleRunButton"
                         StopRequested="StopScript" OpenRequested="OpenScript" SaveRequested="SaveScript"
                         CommentRequested="CommentSelection" UncommentRequested="UncommentSelection"
                         SourceChanged="UpdateSource" KeyDown="HandleEditorKeyDown" />
            <div id="left-row-splitter" class="grid-splitter grid-splitter-horizontal" role="separator" tabindex="0"
                 aria-label="Resize code and diagnostics" aria-orientation="horizontal" aria-valuemin="20" aria-valuemax="80" aria-valuenow="75"></div>
            <DiagnosticsPanel Items="diagnostics" SourceName="@scriptFileName" Selected="GoToDiagnostic" />
        </div>

        <div id="column-splitter" class="grid-splitter grid-splitter-vertical" role="separator" tabindex="0"
             aria-label="Resize script and viewer columns" aria-orientation="vertical" aria-valuemin="25" aria-valuemax="75" aria-valuenow="50"></div>

        <div class="workspace-column workspace-right">
            <ViewerPanel />
            <div id="right-row-splitter" class="grid-splitter grid-splitter-horizontal" role="separator" tabindex="0"
                 aria-label="Resize viewer and output" aria-orientation="horizontal" aria-valuemin="20" aria-valuemax="80" aria-valuenow="75"></div>
            <OutputPanel Output="@output" Status="@runStatus" Failed="runtimeFailed" />
        </div>
    </div>
</main>

@code {
    string source = """
        // Build a twelve-sided 3D prism frame.
        sides = 12;
        radius = 2.5;
        height = 3;
        meshSize = 0.15;
        pi = 3.141592653589793;

        // Generate the lower and upper point rings.
        For i In {0:sides - 1}
          angle = 2 * pi * i / sides;
          x = radius * Cos(angle);
          y = radius * Sin(angle);

          lowerTag = i + 1;
          upperTag = i + 101;
          Point(lowerTag) = {x, y, 0, meshSize};
          Point(upperTag) = {x, y, height, meshSize};
        EndFor

        // Connect each ring and add the vertical supports.
        For i In {0:sides - 1}
          lowerStart = i + 1;
          upperStart = i + 101;
          lowerEnd = i + 2;
          upperEnd = i + 102;

          If (i == sides - 1)
            lowerEnd = 1;
            upperEnd = 101;
          EndIf

          Line(i + 1) = {lowerStart, lowerEnd};
          Line(i + 101) = {upperStart, upperEnd};
          Line(i + 201) = {lowerStart, upperStart};
        EndFor

        // Exercise list indexing and matrix-vector multiplication.
        dimensions = {radius * 2, radius * 2, height};
        transform = {
          {1, 0, 0},
          {0, 1, 0},
          {0, 0, 2}
        };
        scaledDimensions = transform * dimensions;

        Print("Prism dimensions:");
        Print(scaledDimensions);
        Print("Height:");
        Print(scaledDimensions[2]);
        Print(Point(1));
        Print(Line(1));
        """;
    ScriptEditorViewModel editor = null!;
    string? output;
    string? scriptFileName;
    bool runtimeFailed;
    bool isRunning;
    bool hasRun;
    string runStatus = "Ready";
    TimeSpan executionElapsed;
    CancellationTokenSource? executionCancellation;
    readonly System.Diagnostics.Stopwatch executionWatch = new();
    readonly List<string> printedLines = [];
    IReadOnlyList<NamedPointViewModel> namedPoints = [];

    IReadOnlyList<Diagnostic> diagnostics => editor.Diagnostics;
    string? ElapsedText => isRunning || executionElapsed > TimeSpan.Zero
        ? $"{executionElapsed.TotalSeconds:0.000} s"
        : null;

    protected override void OnInitialized() => editor = new ScriptEditorViewModel(source);

    void UpdateSource(ChangeEventArgs args)
    {
        source = args.Value?.ToString() ?? string.Empty;
        output = null;
        runtimeFailed = false;
        printedLines.Clear();
        namedPoints = [];
        editor.Update(source);
    }

    async Task HandleRunButton()
    {
        if (isRunning)
        {
            return;
        }

        await RunScript();
    }

    void StopScript() => executionCancellation?.Cancel();

    async Task OpenScript()
    {
        OpenedScriptFile? file = await JS.InvokeAsync<OpenedScriptFile?>("editorInterop.openScriptFile");
        if (file is null) return;

        scriptFileName = file.Name;
        source = file.Content;
        output = null;
        runtimeFailed = false;
        hasRun = false;
        runStatus = "Ready";
        printedLines.Clear();
        namedPoints = [];
        editor.Update(source);
        await JS.InvokeVoidAsync("editorInterop.replaceEditorContent", "script-editor", source);
    }

    async Task SaveScript()
    {
        string? savedName = await JS.InvokeAsync<string?>(
            "editorInterop.saveScriptFile",
            scriptFileName ?? "script.tus",
            source);
        if (!string.IsNullOrWhiteSpace(savedName)) scriptFileName = savedName;
    }

    Task CommentSelection()
        => JS.InvokeVoidAsync("editorInterop.commentSelection", "script-editor").AsTask();

    Task UncommentSelection()
        => JS.InvokeVoidAsync("editorInterop.uncommentSelection", "script-editor").AsTask();

    async Task RunScript()
    {
        if (isRunning)
        {
            return;
        }

        executionCancellation?.Dispose();
        executionCancellation = new CancellationTokenSource();
        CancellationToken cancellationToken = executionCancellation.Token;
        isRunning = true;
        hasRun = true;
        runtimeFailed = false;
        runStatus = "Running";
        executionElapsed = TimeSpan.Zero;
        executionWatch.Restart();
        _ = UpdateExecutionElapsedAsync();
        StateHasChanged();

        SyntaxTree tree = Analyze();
        if (tree.HasErrors)
        {
            output = "Execution stopped because the script contains syntax errors.";
            runtimeFailed = true;
            runStatus = "Syntax error";
            await JS.InvokeVoidAsync("meshViewer.setScene", Array.Empty<object>(), Array.Empty<object>(), Array.Empty<object>(), Array.Empty<object>(), Array.Empty<object>());
            FinishRun();
            return;
        }

        var evaluator = new EvaluationVisitor();
        try
        {
            printedLines.Clear();
            evaluator.Printed += OnPrinted;
            Value result = await evaluator.EvaluateAsync(tree.Root, cancellationToken);
            ScriptMeshResult? generatedMesh = evaluator.Mesh.GeneratedMesh;
            var outputSections = new List<string>();
            if (printedLines.Count > 0) outputSections.Add(string.Join(Environment.NewLine, printedLines));
            if (generatedMesh is not null)
            {
                outputSections.Add(
                    $"Mesh generated: {generatedMesh.Faces.Count} faces, {generatedMesh.SteinerNodes} Steiner nodes." +
                    $"{Environment.NewLine}Meshing time: {generatedMesh.MeshingTime.TotalSeconds:0.000} s" +
                    $"{Environment.NewLine}{Environment.NewLine}{generatedMesh.Metrics}");
            }
            if (outputSections.Count == 0) outputSections.Add(result.ToString());
            output = string.Join($"{Environment.NewLine}{Environment.NewLine}", outputSections);
            runtimeFailed = false;
            runStatus = "Completed";
            namedPoints = evaluator.Geometry.PhysicalPoints.Values
                .SelectMany(group => group.Points.Select(point => new NamedPointViewModel(
                    group.Name,
                    point.Tag,
                    point.X,
                    point.Y,
                    point.Z,
                    point.MeshSize)))
                .OrderBy(point => point.Name, StringComparer.Ordinal)
                .ThenBy(point => point.Tag)
                .ToArray();
            await JS.InvokeVoidAsync(
                "meshViewer.setScene",
                evaluator.Geometry.Points.Values.Select(point => new
                {
                    point.Tag,
                    point.X,
                    point.Y,
                    point.Z,
                    point.MeshSize,
                    PhysicalNames = point.PhysicalNames
                }),
                evaluator.Geometry.Curves.Values.Select(curve => new
                {
                    curve.Tag,
                    Kind = curve.Kind.ToString(),
                    Path = curve.Tessellate().Select(position => new
                    {
                        position.X,
                        position.Y,
                        position.Z
                    })
                }),
                evaluator.Geometry.PlaneSurfaces.Values.Select(surface => new
                {
                    surface.Tag,
                    Loops = surface.CurveLoops.Select(loop => loop.OrientedCurveTags)
                }),
                evaluator.Geometry.GetTransfiniteNodes().Select(node => new
                {
                    node.CurveTag,
                    node.X,
                    node.Y,
                    node.Z
                }),
                evaluator.Mesh.GeneratedMesh?.Faces
                    .Select(face => new
                {
                    face.SurfaceTag,
                    Kind = (face.ContainsSuperStructure
                        ? FaceKind.Outside
                        : face.Kind).ToString(),
                    face.Vertices
                }) ?? []);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            const string cancelledMessage = "Execution aborted by user.";
            output = printedLines.Count == 0
                ? cancelledMessage
                : $"{string.Join(Environment.NewLine, printedLines)}{Environment.NewLine}{cancelledMessage}";
            runtimeFailed = false;
            runStatus = "Aborted";
        }
        catch (Exception exception) when (exception is InvalidOperationException or InvalidCastException)
        {
            output = exception.Message;
            namedPoints = [];
            runtimeFailed = true;
            runStatus = "Runtime error";
            await JS.InvokeVoidAsync("meshViewer.setScene", Array.Empty<object>(), Array.Empty<object>(), Array.Empty<object>(), Array.Empty<object>(), Array.Empty<object>());
        }
        finally
        {
            evaluator.Printed -= OnPrinted;
            FinishRun();
        }
    }

    async Task UpdateExecutionElapsedAsync()
    {
        while (isRunning)
        {
            await Task.Delay(100);
            executionElapsed = executionWatch.Elapsed;
            await InvokeAsync(StateHasChanged);
        }
    }

    void FinishRun()
    {
        executionWatch.Stop();
        executionElapsed = executionWatch.Elapsed;
        isRunning = false;
        StateHasChanged();
    }

    void OnPrinted(Value value)
    {
        printedLines.Add(value.ToString());
        output = string.Join(Environment.NewLine, printedLines);
        _ = InvokeAsync(StateHasChanged);
    }

    SyntaxTree Analyze()
        => editor.Analyze();

    void HandleEditorKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && (args.CtrlKey || args.MetaKey))
        {
            _ = HandleRunButton();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                string[] meshPropertyNames = new MeshScriptModel().PropertyNames.ToArray();
                var scriptObjects = new Dictionary<string, object>(StringComparer.Ordinal)
                {
                    ["Mesh"] = meshPropertyNames.Select(name =>
                    {
                        ScriptDocumentation.TryGet($"Mesh.{name}", out ScriptDocumentationEntry? documentation);
                        return new
                        {
                            Name = name,
                            Description = documentation?.Description ?? "Mesh configuration property.",
                            Signature = documentation?.Signature,
                            AcceptedValues = documentation?.AcceptedValues
                        };
                    }).ToArray()
                };
                await JS.InvokeVoidAsync("editorInterop.initialize", "script-editor", scriptObjects);
                await JS.InvokeVoidAsync("editorInterop.initializeGridSplitters", ".workspace-layout");
                await JS.InvokeVoidAsync("meshViewer.initialize", "mesh-viewer");
            }
            catch (Exception exception)
            {
                output = $"Editor initialization failed: {exception.Message}";
                runtimeFailed = true;
                runStatus = "UI error";
                StateHasChanged();
                return;
            }
        }

        try
        {
            await JS.InvokeVoidAsync("editorInterop.setHoverDocumentation", "script-editor", editor.HoverDocumentation);
        }
        catch (Exception exception)
        {
            output = $"Documentation tooltip initialization failed: {exception.Message}";
            runtimeFailed = true;
            runStatus = "UI error";
        }
    }

    async Task GoToDiagnostic(Diagnostic diagnostic)
    {
        await JS.InvokeVoidAsync(
            "editorInterop.selectRange",
            "script-editor",
            diagnostic.Span.Start,
            Math.Max(1, diagnostic.Span.Length));
    }

    public void Dispose()
    {
        executionCancellation?.Cancel();
        executionCancellation?.Dispose();
    }

    sealed record OpenedScriptFile(string Name, string Content);
}
