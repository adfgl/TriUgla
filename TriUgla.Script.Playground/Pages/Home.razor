@page "/"
@inject IJSRuntime JS
@implements IDisposable

<main class="workspace">
    <header class="app-header">
        <div>
            <p class="eyebrow">TriUgla / browser playground</p>
            <h1>Script editor</h1>
        </div>
    </header>

    <div class="dock-layout" aria-label="Dockable workspace">
    <div class="dock-host dock-top" data-dock="top">
        <div class="dock-tabs" role="tablist" aria-label="Top panels"></div>
        <div class="dock-content"></div>
    </div>

    <div class="dock-splitter dock-top-splitter" data-resize-dock="top" role="separator" tabindex="0"
         aria-label="Resize top dock" aria-orientation="horizontal"></div>

    <div class="dock-host dock-left" data-dock="left">
        <div class="dock-tabs" role="tablist" aria-label="Left panels"></div>
        <div class="dock-content"></div>
    </div>

    <div class="dock-splitter dock-left-splitter" data-resize-dock="left" role="separator" tabindex="0"
         aria-label="Resize left dock" aria-orientation="vertical"></div>

    <div class="dock-host dock-center" data-dock="center">
        <div class="dock-tabs" role="tablist" aria-label="Center panels"></div>
        <div class="dock-content">
            <EditorPanel Model="editor" IsRunning="isRunning" HasRun="hasRun" Status="@runStatus"
                         ElapsedText="@ElapsedText" RunRequested="HandleRunButton"
                         SourceChanged="UpdateSource" KeyDown="HandleEditorKeyDown" />
        </div>
    </div>

    <div class="dock-splitter dock-right-splitter" data-resize-dock="right" role="separator" tabindex="0"
         aria-label="Resize right dock" aria-orientation="vertical"></div>

    <div class="dock-host dock-right" data-dock="right">
        <div class="dock-tabs" role="tablist" aria-label="Right panels"></div>
        <div class="dock-content">
            <ViewerPanel />
        </div>
    </div>

    <div class="dock-splitter dock-bottom-splitter" data-resize-dock="bottom" role="separator" tabindex="0"
         aria-label="Resize bottom dock" aria-orientation="horizontal"></div>

    <div class="dock-host dock-bottom" data-dock="bottom">
        <div class="dock-tabs" role="tablist" aria-label="Bottom panels"></div>
        <div class="dock-content">
            <DiagnosticsPanel Items="diagnostics" Selected="GoToDiagnostic" />
            <OutputPanel Output="@output" Status="@runStatus" Failed="runtimeFailed" />
        </div>
    </div>
    </div>
</main>

@code {
    string source = """
        // Build a twelve-sided 3D prism frame.
        sides = 12;
        radius = 2.5;
        height = 3;
        meshSize = 0.15;
        pi = 3.141592653589793;

        // Generate the lower and upper point rings.
        For i In {0:sides - 1}
          angle = 2 * pi * i / sides;
          x = radius * Cos(angle);
          y = radius * Sin(angle);

          lowerTag = i + 1;
          upperTag = i + 101;
          Point(lowerTag) = {x, y, 0, meshSize};
          Point(upperTag) = {x, y, height, meshSize};
        EndFor

        // Connect each ring and add the vertical supports.
        For i In {0:sides - 1}
          lowerStart = i + 1;
          upperStart = i + 101;
          lowerEnd = i + 2;
          upperEnd = i + 102;

          If (i == sides - 1)
            lowerEnd = 1;
            upperEnd = 101;
          EndIf

          Line(i + 1) = {lowerStart, lowerEnd};
          Line(i + 101) = {upperStart, upperEnd};
          Line(i + 201) = {lowerStart, upperStart};
        EndFor

        // Exercise list indexing and matrix-vector multiplication.
        dimensions = {radius * 2, radius * 2, height};
        transform = {
          {1, 0, 0},
          {0, 1, 0},
          {0, 0, 2}
        };
        scaledDimensions = transform * dimensions;

        Print("Prism dimensions:");
        Print(scaledDimensions);
        Print("Height:");
        Print(scaledDimensions[2]);
        Print(Point(1));
        Print(Line(1));
        """;
    ScriptEditorViewModel editor = null!;
    string? output;
    bool runtimeFailed;
    bool isRunning;
    bool hasRun;
    string runStatus = "Ready";
    TimeSpan elapsed;
    CancellationTokenSource? executionCancellation;
    readonly System.Diagnostics.Stopwatch executionWatch = new();
    readonly List<string> printedLines = [];

    IReadOnlyList<Diagnostic> diagnostics => editor.Diagnostics;
    string ElapsedText => $"{elapsed.TotalSeconds:0.000} s";

    protected override void OnInitialized() => editor = new ScriptEditorViewModel(source);

    void UpdateSource(ChangeEventArgs args)
    {
        source = args.Value?.ToString() ?? string.Empty;
        output = null;
        runtimeFailed = false;
        printedLines.Clear();
        editor.Update(source);
    }

    async Task HandleRunButton()
    {
        if (isRunning)
        {
            executionCancellation?.Cancel();
            return;
        }

        await RunScript();
    }

    async Task RunScript()
    {
        if (isRunning)
        {
            return;
        }

        executionCancellation?.Dispose();
        executionCancellation = new CancellationTokenSource();
        CancellationToken cancellationToken = executionCancellation.Token;
        isRunning = true;
        hasRun = true;
        runtimeFailed = false;
        runStatus = "Running";
        elapsed = TimeSpan.Zero;
        executionWatch.Restart();
        _ = UpdateElapsedAsync();
        StateHasChanged();

        await JS.InvokeVoidAsync("dockInterop.reveal", "output");
        SyntaxTree tree = Analyze();
        if (tree.HasErrors)
        {
            output = "Execution stopped because the script contains syntax errors.";
            runtimeFailed = true;
            runStatus = "Syntax error";
            await JS.InvokeVoidAsync("meshViewer.setScene", Array.Empty<object>(), Array.Empty<object>());
            FinishRun();
            return;
        }

        var evaluator = new EvaluationVisitor();
        try
        {
            printedLines.Clear();
            evaluator.Printed += OnPrinted;
            Value result = await evaluator.EvaluateAsync(tree.Root, cancellationToken);
            output = printedLines.Count == 0 ? result.ToString() : string.Join(Environment.NewLine, printedLines);
            runtimeFailed = false;
            runStatus = "Completed";
            await JS.InvokeVoidAsync(
                "meshViewer.setScene",
                evaluator.Geometry.Points.Values.Select(point => new { point.Tag, point.X, point.Y, point.Z }),
                evaluator.Geometry.Curves.Values.Select(curve => new
                {
                    curve.Tag,
                    Kind = curve.Kind.ToString(),
                    Path = curve.Tessellate().Select(position => new
                    {
                        position.X,
                        position.Y,
                        position.Z
                    })
                }),
                evaluator.Geometry.PlaneSurfaces.Values.Select(surface => new
                {
                    surface.Tag,
                    Loops = surface.CurveLoops.Select(loop => loop.OrientedCurveTags)
                }),
                evaluator.Geometry.GetTransfiniteNodes().Select(node => new
                {
                    node.CurveTag,
                    node.X,
                    node.Y,
                    node.Z
                }));
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            const string cancelledMessage = "Execution aborted by user.";
            output = printedLines.Count == 0
                ? cancelledMessage
                : $"{string.Join(Environment.NewLine, printedLines)}{Environment.NewLine}{cancelledMessage}";
            runtimeFailed = false;
            runStatus = "Aborted";
        }
        catch (Exception exception) when (exception is InvalidOperationException or InvalidCastException)
        {
            output = exception.Message;
            runtimeFailed = true;
            runStatus = "Runtime error";
            await JS.InvokeVoidAsync("meshViewer.setScene", Array.Empty<object>(), Array.Empty<object>());
        }
        finally
        {
            evaluator.Printed -= OnPrinted;
            FinishRun();
        }
    }

    async Task UpdateElapsedAsync()
    {
        while (isRunning)
        {
            await Task.Delay(100);
            elapsed = executionWatch.Elapsed;
            await InvokeAsync(StateHasChanged);
        }
    }

    void FinishRun()
    {
        executionWatch.Stop();
        elapsed = executionWatch.Elapsed;
        isRunning = false;
        StateHasChanged();
    }

    void OnPrinted(Value value)
    {
        printedLines.Add(value.ToString());
        output = string.Join(Environment.NewLine, printedLines);
        _ = InvokeAsync(StateHasChanged);
    }

    SyntaxTree Analyze()
        => editor.Analyze();

    void HandleEditorKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && (args.CtrlKey || args.MetaKey))
        {
            _ = HandleRunButton();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var scriptObjects = new Dictionary<string, IReadOnlyList<string>>(StringComparer.Ordinal)
                {
                    ["Mesh"] = new MeshScriptModel().PropertyNames
                };
                await JS.InvokeVoidAsync("editorInterop.initialize", "script-editor", scriptObjects);
                await JS.InvokeVoidAsync("dockInterop.initialize", ".workspace");
                await JS.InvokeVoidAsync("meshViewer.initialize", "mesh-viewer");
            }
            catch (Exception exception)
            {
                output = $"Editor initialization failed: {exception.Message}";
                runtimeFailed = true;
                runStatus = "UI error";
                StateHasChanged();
                return;
            }
        }

        try
        {
            await JS.InvokeVoidAsync("editorInterop.setHoverDocumentation", "script-editor", editor.HoverDocumentation);
        }
        catch (Exception exception)
        {
            output = $"Documentation tooltip initialization failed: {exception.Message}";
            runtimeFailed = true;
            runStatus = "UI error";
        }
    }

    async Task GoToDiagnostic(Diagnostic diagnostic)
    {
        await JS.InvokeVoidAsync("dockInterop.reveal", "editor");
        await JS.InvokeVoidAsync(
            "editorInterop.selectRange",
            "script-editor",
            diagnostic.Span.Start,
            Math.Max(1, diagnostic.Span.Length));
    }

    public void Dispose()
    {
        executionCancellation?.Cancel();
        executionCancellation?.Dispose();
    }
}
