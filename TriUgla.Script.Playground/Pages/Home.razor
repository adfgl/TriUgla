@page "/"
@inject IJSRuntime JS
@implements IDisposable

<main class="workspace">
    <header class="app-header">
        <div>
            <p class="eyebrow">TriUgla / browser playground</p>
            <h1>Script editor</h1>
        </div>
    </header>

    <div class="dock-layout" aria-label="Dockable workspace">
    <div class="dock-host dock-top" data-dock="top">
        <div class="dock-tabs" role="tablist" aria-label="Top panels"></div>
        <div class="dock-content"></div>
    </div>

    <div class="dock-splitter dock-top-splitter" data-resize-dock="top" role="separator" tabindex="0"
         aria-label="Resize top dock" aria-orientation="horizontal"></div>

    <div class="dock-host dock-left" data-dock="left">
        <div class="dock-tabs" role="tablist" aria-label="Left panels"></div>
        <div class="dock-content"></div>
    </div>

    <div class="dock-splitter dock-left-splitter" data-resize-dock="left" role="separator" tabindex="0"
         aria-label="Resize left dock" aria-orientation="vertical"></div>

    <div class="dock-host dock-center" data-dock="center">
        <div class="dock-tabs" role="tablist" aria-label="Center panels"></div>
        <div class="dock-content">
    <section class="editor-panel dock-panel" data-panel-id="editor" data-panel-title="main.tus" aria-labelledby="editor-label">
        <div class="panel-bar">
            <div class="file-name" id="editor-label">
                <span class="status-dot @(ErrorCount > 0 ? "has-errors" : null)" aria-hidden="true"></span>
                main.tus
            </div>
            <div class="editor-actions">
                @if (isRunning || hasRun)
                {
                    <span class="execution-time" aria-live="polite">@(isRunning ? "Running" : runStatus) · @ElapsedText</span>
                }
                <span>@LineCount lines</span>
                <button class="run-button @(isRunning ? "abort-button" : null)"
                        type="button"
                        @onclick="HandleRunButton"
                        aria-label="@(isRunning ? "Abort script execution" : "Run script")"
                        aria-keyshortcuts="Control+Enter Meta+Enter">
                    @if (isRunning)
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10H7z" /></svg>
                        <span>Abort</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                        <span>Run</span>
                    }
                    <kbd>Ctrl ↵</kbd>
                </button>
            </div>
        </div>
        <div class="editor-shell">
            <div id="line-numbers" class="line-numbers" aria-hidden="true">
                @for (var line = 1; line <= LineCount; line++)
                {
                    <span>@line</span>
                }
            </div>
            <div class="code-surface">
                <pre id="highlight-layer" class="highlight-layer" aria-hidden="true"><code>@foreach (HighlightSegment segment in HighlightSegments)
                    {<span class="@segment.CssClass">@segment.Text</span>}</code></pre>
                <textarea id="script-editor"
                          class="script-editor"
                          value="@source"
                          @oninput="UpdateSource"
                          @onkeydown="HandleEditorKeyDown"
                          onscroll="editorInterop.syncScroll(this)"
                          aria-label="Script source code"
                          aria-describedby="diagnostics-title"
                          spellcheck="false"></textarea>
            </div>
        </div>
    </section>
        </div>
    </div>

    <div class="dock-splitter dock-right-splitter" data-resize-dock="right" role="separator" tabindex="0"
         aria-label="Resize right dock" aria-orientation="vertical"></div>

    <div class="dock-host dock-right" data-dock="right">
        <div class="dock-tabs" role="tablist" aria-label="Right panels"></div>
        <div class="dock-content">
    <section class="viewer-panel dock-panel" data-panel-id="viewer" data-panel-title="3D View" aria-labelledby="viewer-title">
        <div class="panel-bar viewer-bar">
            <div>
                <h2 id="viewer-title">3D view</h2>
                <span class="camera-label">Orthographic orbit camera</span>
            </div>
            <div class="viewer-actions">
                <button type="button" onclick="meshViewer.fit()" aria-label="Fit mesh in view">Fit</button>
                <button type="button" onclick="meshViewer.reset()" aria-label="Reset camera">Reset</button>
            </div>
        </div>
        <div class="viewer-surface">
            <canvas id="mesh-viewer"
                    tabindex="0"
                    aria-label="Orthographic 3D mesh view. Drag to rotate, Shift-drag to pan, and scroll to zoom."></canvas>
            <div class="viewer-help" aria-hidden="true">Drag rotate · Shift/right drag pan · Scroll zoom</div>
        </div>
    </section>
        </div>
    </div>

    <div class="dock-splitter dock-bottom-splitter" data-resize-dock="bottom" role="separator" tabindex="0"
         aria-label="Resize bottom dock" aria-orientation="horizontal"></div>

    <div class="dock-host dock-bottom" data-dock="bottom">
        <div class="dock-tabs" role="tablist" aria-label="Bottom panels"></div>
        <div class="dock-content">
    <section class="diagnostics-panel dock-panel" data-panel-id="diagnostics" data-panel-title="Problems" aria-labelledby="diagnostics-title" aria-live="polite">
        <div class="panel-bar diagnostics-bar">
            <div class="diagnostics-heading">
                <h2 id="diagnostics-title">Diagnostics</h2>
                <span class="count error-count">@ErrorCount errors</span>
                <span class="count info-count">@InfoCount info</span>
            </div>
            <span class="run-time">Live syntax check</span>
        </div>

        <div class="diagnostics-list">
            @if (diagnostics.Count == 0)
            {
                <div class="empty-state success-state">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4L19 6" /></svg>
                    <div><strong>No errors found</strong><p>The script parsed successfully.</p></div>
                </div>
            }
            else
            {
                @foreach (var diagnostic in diagnostics)
                {
                    <button class="diagnostic-row severity-@diagnostic.Severity.ToString().ToLowerInvariant()"
                            type="button"
                            @onclick="() => GoToDiagnostic(diagnostic)"
                            aria-label="Go to line @diagnostic.Span.Line, column @diagnostic.Span.Column: @diagnostic.Message">
                        <span class="severity-icon" aria-hidden="true">!</span>
                        <span class="diagnostic-copy">
                            <span><strong>@diagnostic.Code</strong> @diagnostic.Message</span>
                            <span class="location">main.tus:@diagnostic.Span.Line:@diagnostic.Span.Column</span>
                        </span>
                        <svg class="jump-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
                    </button>
                }
            }
        </div>
    </section>

    <section class="output-panel dock-panel" data-panel-id="output" data-panel-title="Output" aria-labelledby="output-title" aria-live="polite">
        <div class="panel-bar">
            <h2 id="output-title">Output</h2>
            @if (output is not null)
            {
                <span class="output-status @(runtimeFailed ? "failed" : runStatus == "Aborted" ? "cancelled" : null)">@runStatus</span>
            }
        </div>
        <pre class="output-content @(runtimeFailed ? "failed" : null)">@(output ?? "Run the script to see its result.")</pre>
    </section>
        </div>
    </div>
    </div>
</main>

@code {
    string source = """
        // Build a twelve-sided 3D prism frame.
        sides = 12;
        radius = 2.5;
        height = 3;
        meshSize = 0.15;
        pi = 3.141592653589793;

        // Generate the lower and upper point rings.
        For i In {0:sides - 1}
          angle = 2 * pi * i / sides;
          x = radius * Cos(angle);
          y = radius * Sin(angle);

          lowerTag = i + 1;
          upperTag = i + 101;
          Point(lowerTag) = {x, y, 0, meshSize};
          Point(upperTag) = {x, y, height, meshSize};
        EndFor

        // Connect each ring and add the vertical supports.
        For i In {0:sides - 1}
          lowerStart = i + 1;
          upperStart = i + 101;
          lowerEnd = i + 2;
          upperEnd = i + 102;

          If (i == sides - 1)
            lowerEnd = 1;
            upperEnd = 101;
          EndIf

          Line(i + 1) = {lowerStart, lowerEnd};
          Line(i + 101) = {upperStart, upperEnd};
          Line(i + 201) = {lowerStart, upperStart};
        EndFor

        // Exercise list indexing and matrix-vector multiplication.
        dimensions = {radius * 2, radius * 2, height};
        transform = {
          {1, 0, 0},
          {0, 1, 0},
          {0, 0, 2}
        };
        scaledDimensions = transform * dimensions;

        Print("Prism dimensions:");
        Print(scaledDimensions);
        Print("Height:");
        Print(scaledDimensions[2]);
        Print(Point(1));
        Print(Line(1));
        """;
    IReadOnlyList<Diagnostic> diagnostics = [];
    IReadOnlyList<Token> tokens = [];
    IReadOnlySet<int> functionTokenStarts = new HashSet<int>();
    string? output;
    bool runtimeFailed;
    bool isRunning;
    bool hasRun;
    string runStatus = "Ready";
    TimeSpan elapsed;
    CancellationTokenSource? executionCancellation;
    readonly System.Diagnostics.Stopwatch executionWatch = new();
    readonly List<string> printedLines = [];

    int LineCount => Math.Max(1, source.Count(character => character == '\n') + 1);
    int ErrorCount => diagnostics.Count(item => item.Severity == DiagnosticSeverity.Error);
    int InfoCount => diagnostics.Count(item => item.Severity == DiagnosticSeverity.Info);
    string ElapsedText => $"{elapsed.TotalSeconds:0.000} s";
    IReadOnlyList<HighlightSegment> HighlightSegments => BuildHighlightSegments();

    protected override void OnInitialized() => Analyze();

    void UpdateSource(ChangeEventArgs args)
    {
        source = args.Value?.ToString() ?? string.Empty;
        output = null;
        runtimeFailed = false;
        printedLines.Clear();
        Analyze();
    }

    async Task HandleRunButton()
    {
        if (isRunning)
        {
            executionCancellation?.Cancel();
            return;
        }

        await RunScript();
    }

    async Task RunScript()
    {
        if (isRunning)
        {
            return;
        }

        executionCancellation?.Dispose();
        executionCancellation = new CancellationTokenSource();
        CancellationToken cancellationToken = executionCancellation.Token;
        isRunning = true;
        hasRun = true;
        runtimeFailed = false;
        runStatus = "Running";
        elapsed = TimeSpan.Zero;
        executionWatch.Restart();
        _ = UpdateElapsedAsync();
        StateHasChanged();

        await JS.InvokeVoidAsync("dockInterop.reveal", "output");
        SyntaxTree tree = Analyze();
        if (tree.HasErrors)
        {
            output = "Execution stopped because the script contains syntax errors.";
            runtimeFailed = true;
            runStatus = "Syntax error";
            await JS.InvokeVoidAsync("meshViewer.setScene", Array.Empty<object>(), Array.Empty<object>());
            FinishRun();
            return;
        }

        var evaluator = new EvaluationVisitor();
        try
        {
            printedLines.Clear();
            evaluator.Printed += OnPrinted;
            Value result = await evaluator.EvaluateAsync(tree.Root, cancellationToken);
            output = printedLines.Count == 0 ? result.ToString() : string.Join(Environment.NewLine, printedLines);
            runtimeFailed = false;
            runStatus = "Completed";
            await JS.InvokeVoidAsync(
                "meshViewer.setScene",
                evaluator.Geometry.Points.Values.Select(point => new { point.Tag, point.X, point.Y, point.Z }),
                evaluator.Geometry.Lines.Values.Select(line => new
                {
                    line.Tag,
                    StartTag = line.Start.Tag,
                    EndTag = line.End.Tag
                }),
                evaluator.Geometry.PlaneSurfaces.Values.Select(surface => new
                {
                    surface.Tag,
                    Loops = surface.CurveLoops.Select(loop => loop.OrientedCurveTags)
                }));
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            const string cancelledMessage = "Execution aborted by user.";
            output = printedLines.Count == 0
                ? cancelledMessage
                : $"{string.Join(Environment.NewLine, printedLines)}{Environment.NewLine}{cancelledMessage}";
            runtimeFailed = false;
            runStatus = "Aborted";
        }
        catch (Exception exception) when (exception is InvalidOperationException or InvalidCastException)
        {
            output = exception.Message;
            runtimeFailed = true;
            runStatus = "Runtime error";
            await JS.InvokeVoidAsync("meshViewer.setScene", Array.Empty<object>(), Array.Empty<object>());
        }
        finally
        {
            evaluator.Printed -= OnPrinted;
            FinishRun();
        }
    }

    async Task UpdateElapsedAsync()
    {
        while (isRunning)
        {
            await Task.Delay(100);
            elapsed = executionWatch.Elapsed;
            await InvokeAsync(StateHasChanged);
        }
    }

    void FinishRun()
    {
        executionWatch.Stop();
        elapsed = executionWatch.Elapsed;
        isRunning = false;
        StateHasChanged();
    }

    void OnPrinted(Value value)
    {
        printedLines.Add(value.ToString());
        output = string.Join(Environment.NewLine, printedLines);
        _ = InvokeAsync(StateHasChanged);
    }

    SyntaxTree Analyze()
    {
        SyntaxTree tree = SyntaxTree.Parse(source);
        diagnostics = tree.Diagnostics;
        tokens = new Tokenizer(source).Tokenize();
        functionTokenStarts = tokens
            .Take(tokens.Count - 1)
            .Select((token, index) => (token, index))
            .Where(item =>
                item.token.Kind == TokenKind.Identifier &&
                tokens[item.index + 1].Kind == TokenKind.LeftParenthesis)
            .Select(item => item.token.Span.Start)
            .ToHashSet();
        return tree;
    }

    void HandleEditorKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && (args.CtrlKey || args.MetaKey))
        {
            _ = HandleRunButton();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("editorInterop.initialize", "script-editor");
            await JS.InvokeVoidAsync("dockInterop.initialize", ".workspace");
            await JS.InvokeVoidAsync("meshViewer.initialize", "mesh-viewer");
        }
    }

    async Task GoToDiagnostic(Diagnostic diagnostic)
    {
        await JS.InvokeVoidAsync("dockInterop.reveal", "editor");
        await JS.InvokeVoidAsync(
            "editorInterop.selectRange",
            "script-editor",
            diagnostic.Span.Start,
            Math.Max(1, diagnostic.Span.Length));
    }

    IReadOnlyList<HighlightSegment> BuildHighlightSegments()
    {
        if (source.Length == 0)
        {
            return [];
        }

        var boundaries = new SortedSet<int> { 0, source.Length };
        foreach (Token token in tokens.Where(item => item.Kind != TokenKind.EndOfFile))
        {
            boundaries.Add(Math.Clamp(token.Span.Start, 0, source.Length));
            boundaries.Add(Math.Clamp(token.Span.End, 0, source.Length));
        }

        foreach (Diagnostic diagnostic in diagnostics)
        {
            int start = Math.Clamp(diagnostic.Span.Start, 0, source.Length - 1);
            int end = Math.Clamp(start + Math.Max(1, diagnostic.Span.Length), start + 1, source.Length);
            boundaries.Add(start);
            boundaries.Add(end);
        }

        int[] positions = boundaries.ToArray();
        var segments = new List<HighlightSegment>(positions.Length - 1);
        for (int index = 0; index < positions.Length - 1; index++)
        {
            int start = positions[index];
            int end = positions[index + 1];
            Token token = tokens.FirstOrDefault(item =>
                item.Kind != TokenKind.EndOfFile && start >= item.Span.Start && start < item.Span.End);
            bool hasError = diagnostics.Any(item =>
            {
                int errorStart = Math.Clamp(item.Span.Start, 0, source.Length - 1);
                int errorEnd = Math.Min(source.Length, errorStart + Math.Max(1, item.Span.Length));
                return start < errorEnd && end > errorStart;
            });
            string tokenClass = token.Kind == TokenKind.EndOfFile ? "token-plain" : TokenClass(token);
            segments.Add(new HighlightSegment(source[start..end], $"{tokenClass}{(hasError ? " token-error" : string.Empty)}"));
        }

        return segments;
    }

    string TokenClass(Token token) => token.Kind switch
    {
        TokenKind.Keyword => "token-keyword",
        TokenKind.Number => "token-number",
        TokenKind.String => "token-string",
        TokenKind.Identifier when functionTokenStarts.Contains(token.Span.Start) => "token-function",
        TokenKind.Identifier => "token-identifier",
        TokenKind.BadToken => "token-bad",
        _ => "token-symbol"
    };

    sealed record HighlightSegment(string Text, string CssClass);

    public void Dispose()
    {
        executionCancellation?.Cancel();
        executionCancellation?.Dispose();
    }
}
