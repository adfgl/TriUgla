@page "/"
@inject IJSRuntime JS

<main class="workspace">
    <header class="app-header">
        <div>
            <p class="eyebrow">TriUgla / browser playground</p>
            <h1>Script editor</h1>
        </div>
        <button class="run-button" type="button" @onclick="RunScript" aria-keyshortcuts="Control+Enter Meta+Enter">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            Run script
            <kbd>Ctrl ↵</kbd>
        </button>
    </header>

    <section class="editor-panel" aria-labelledby="editor-label">
        <div class="panel-bar">
            <div class="file-name" id="editor-label">
                <span class="status-dot @(ErrorCount > 0 ? "has-errors" : null)" aria-hidden="true"></span>
                main.tus
            </div>
            <span>@LineCount lines</span>
        </div>
        <div class="editor-shell">
            <div id="line-numbers" class="line-numbers" aria-hidden="true">
                @for (var line = 1; line <= LineCount; line++)
                {
                    <span>@line</span>
                }
            </div>
            <div class="code-surface">
                <pre id="highlight-layer" class="highlight-layer" aria-hidden="true"><code>@foreach (HighlightSegment segment in HighlightSegments)
                    {<span class="@segment.CssClass">@segment.Text</span>}</code></pre>
                <textarea id="script-editor"
                          class="script-editor"
                          value="@source"
                          @oninput="UpdateSource"
                          @onkeydown="HandleEditorKeyDown"
                          onscroll="editorInterop.syncScroll(this)"
                          aria-label="Script source code"
                          aria-describedby="diagnostics-title"
                          spellcheck="false"></textarea>
            </div>
        </div>
    </section>

    <section class="diagnostics-panel" aria-labelledby="diagnostics-title" aria-live="polite">
        <div class="panel-bar diagnostics-bar">
            <div class="diagnostics-heading">
                <h2 id="diagnostics-title">Diagnostics</h2>
                <span class="count error-count">@ErrorCount errors</span>
                <span class="count info-count">@InfoCount info</span>
            </div>
            <span class="run-time">Live syntax check</span>
        </div>

        <div class="diagnostics-list">
            @if (diagnostics.Count == 0)
            {
                <div class="empty-state success-state">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4L19 6" /></svg>
                    <div><strong>No errors found</strong><p>The script parsed successfully.</p></div>
                </div>
            }
            else
            {
                @foreach (var diagnostic in diagnostics)
                {
                    <button class="diagnostic-row severity-@diagnostic.Severity.ToString().ToLowerInvariant()"
                            type="button"
                            @onclick="() => GoToDiagnostic(diagnostic)"
                            aria-label="Go to line @diagnostic.Span.Line, column @diagnostic.Span.Column: @diagnostic.Message">
                        <span class="severity-icon" aria-hidden="true">!</span>
                        <span class="diagnostic-copy">
                            <span><strong>@diagnostic.Code</strong> @diagnostic.Message</span>
                            <span class="location">main.tus:@diagnostic.Span.Line:@diagnostic.Span.Column</span>
                        </span>
                        <svg class="jump-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
                    </button>
                }
            }
        </div>
    </section>

    <section class="output-panel" aria-labelledby="output-title" aria-live="polite">
        <div class="panel-bar">
            <h2 id="output-title">Output</h2>
            @if (output is not null)
            {
                <span class="output-status @(runtimeFailed ? "failed" : null)">@(runtimeFailed ? "Runtime error" : "Completed")</span>
            }
        </div>
        <pre class="output-content @(runtimeFailed ? "failed" : null)">@(output ?? "Run the script to see its result.")</pre>
    </section>
</main>

@code {
    string source = "matrix = {\n  {1, 2, 3},\n  {4, 5, 6},\n  {7, 8, 9}\n};\n\nvector = {11, 22, 33};\nPrint(matrix * vector);";
    IReadOnlyList<Diagnostic> diagnostics = [];
    IReadOnlyList<Token> tokens = [];
    IReadOnlySet<int> functionTokenStarts = new HashSet<int>();
    string? output;
    bool runtimeFailed;
    readonly List<string> printedLines = [];

    int LineCount => Math.Max(1, source.Count(character => character == '\n') + 1);
    int ErrorCount => diagnostics.Count(item => item.Severity == DiagnosticSeverity.Error);
    int InfoCount => diagnostics.Count(item => item.Severity == DiagnosticSeverity.Info);
    IReadOnlyList<HighlightSegment> HighlightSegments => BuildHighlightSegments();

    protected override void OnInitialized() => Analyze();

    void UpdateSource(ChangeEventArgs args)
    {
        source = args.Value?.ToString() ?? string.Empty;
        output = null;
        runtimeFailed = false;
        printedLines.Clear();
        Analyze();
    }

    void RunScript()
    {
        SyntaxTree tree = Analyze();
        if (tree.HasErrors)
        {
            output = "Execution stopped because the script contains syntax errors.";
            runtimeFailed = true;
            return;
        }

        try
        {
            printedLines.Clear();
            var evaluator = new EvaluationVisitor();
            evaluator.Printed += OnPrinted;
            Value result = evaluator.Evaluate(tree.Root);
            output = printedLines.Count == 0 ? result.ToString() : string.Join(Environment.NewLine, printedLines);
            runtimeFailed = false;
        }
        catch (Exception exception) when (exception is InvalidOperationException or InvalidCastException)
        {
            output = exception.Message;
            runtimeFailed = true;
        }
    }

    void OnPrinted(Value value)
    {
        printedLines.Add(value.ToString());
        output = string.Join(Environment.NewLine, printedLines);
        _ = InvokeAsync(StateHasChanged);
    }

    SyntaxTree Analyze()
    {
        SyntaxTree tree = SyntaxTree.Parse(source);
        diagnostics = tree.Diagnostics;
        tokens = new Tokenizer(source).Tokenize();
        functionTokenStarts = tokens
            .Take(tokens.Count - 1)
            .Select((token, index) => (token, index))
            .Where(item =>
                item.token.Kind == TokenKind.Identifier &&
                tokens[item.index + 1].Kind == TokenKind.LeftParenthesis)
            .Select(item => item.token.Span.Start)
            .ToHashSet();
        return tree;
    }

    void HandleEditorKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && (args.CtrlKey || args.MetaKey))
        {
            RunScript();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("editorInterop.initialize", "script-editor");
        }
    }

    async Task GoToDiagnostic(Diagnostic diagnostic)
    {
        await JS.InvokeVoidAsync(
            "editorInterop.selectRange",
            "script-editor",
            diagnostic.Span.Start,
            Math.Max(1, diagnostic.Span.Length));
    }

    IReadOnlyList<HighlightSegment> BuildHighlightSegments()
    {
        if (source.Length == 0)
        {
            return [];
        }

        var boundaries = new SortedSet<int> { 0, source.Length };
        foreach (Token token in tokens.Where(item => item.Kind != TokenKind.EndOfFile))
        {
            boundaries.Add(Math.Clamp(token.Span.Start, 0, source.Length));
            boundaries.Add(Math.Clamp(token.Span.End, 0, source.Length));
        }

        foreach (Diagnostic diagnostic in diagnostics)
        {
            int start = Math.Clamp(diagnostic.Span.Start, 0, source.Length - 1);
            int end = Math.Clamp(start + Math.Max(1, diagnostic.Span.Length), start + 1, source.Length);
            boundaries.Add(start);
            boundaries.Add(end);
        }

        int[] positions = boundaries.ToArray();
        var segments = new List<HighlightSegment>(positions.Length - 1);
        for (int index = 0; index < positions.Length - 1; index++)
        {
            int start = positions[index];
            int end = positions[index + 1];
            Token token = tokens.FirstOrDefault(item =>
                item.Kind != TokenKind.EndOfFile && start >= item.Span.Start && start < item.Span.End);
            bool hasError = diagnostics.Any(item =>
            {
                int errorStart = Math.Clamp(item.Span.Start, 0, source.Length - 1);
                int errorEnd = Math.Min(source.Length, errorStart + Math.Max(1, item.Span.Length));
                return start < errorEnd && end > errorStart;
            });
            string tokenClass = token.Kind == TokenKind.EndOfFile ? "token-plain" : TokenClass(token);
            segments.Add(new HighlightSegment(source[start..end], $"{tokenClass}{(hasError ? " token-error" : string.Empty)}"));
        }

        return segments;
    }

    string TokenClass(Token token) => token.Kind switch
    {
        TokenKind.Keyword => "token-keyword",
        TokenKind.Number => "token-number",
        TokenKind.String => "token-string",
        TokenKind.Identifier when functionTokenStarts.Contains(token.Span.Start) => "token-function",
        TokenKind.Identifier => "token-identifier",
        TokenKind.BadToken => "token-bad",
        _ => "token-symbol"
    };

    sealed record HighlightSegment(string Text, string CssClass);
}
