@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS

<main class="editor-shell">
    <header class="toolbar">
        <div class="brand">
            <span>TRIUGLA</span>
            <h1>Mesh Editor</h1>
        </div>
        <div class="toolbar-actions">
            <label class="toggle" title="Show or hide super-structure topology">
                <input type="checkbox" checked="@_showSuperStructure" @onchange="ToggleSuperStructure" />
                <span>Super structure</span>
            </label>
            <button type="button" class="@(_quadMode ? "quad-toggle active" : "quad-toggle")"
                    title="@(_quadMode ? "Return to editable triangular mesh" : "Build and show read-only quad representation")"
                    aria-pressed="@_quadMode" @onclick="ToggleQuadMesh">
                @(_quadMode ? "Back to triangles" : "Quad overlay")
            </button>
            <button type="button" class="@(_view3D ? "view-toggle active" : "view-toggle")"
                    title="@(_view3D ? "Return to editable plan view" : "Show read-only elevation view")"
                    aria-pressed="@_view3D" @onclick="Toggle3DView">
                @(_view3D ? "Back to plan" : "3D elevation")
            </button>
            <button type="button" title="Undo (Cmd+Z)" disabled="@(ReadOnlyMode || !_canUndo)" @onclick="Undo">Undo</button>
            <button type="button" title="Redo (Cmd+Shift+Z)" disabled="@(ReadOnlyMode || !_canRedo)" @onclick="Redo">Redo</button>
            <fieldset class="refine-scope" disabled="@ReadOnlyMode" aria-label="Face kinds to refine">
                <legend>Refine</legend>
                <label title="Include land faces"><input type="checkbox" @bind="_refineLand" /> Land</label>
                <label title="Include lake faces"><input type="checkbox" @bind="_refineLakes" /> Lakes</label>
            </fieldset>
            <button type="button" title="Refine selected faces, or all eligible faces when none are selected"
                    disabled="@(ReadOnlyMode || (!_refineLand && !_refineLakes))"
                    @onclick="RefineSelectedFaces">Refine</button>
            <button type="button" title="Reset view (0)" @onclick="Reset">Reset <kbd>0</kbd></button>
            <button type="button" title="Fit mesh to viewport (F)" @onclick="Fit">Fit <kbd>F</kbd></button>
            <button type="button" title="Remove inserted nodes" disabled="@ReadOnlyMode" @onclick="ResetMesh">Reset mesh</button>
        </div>
    </header>

    <section class="workspace">
        <aside class="tool-panel" aria-label="Mesh tools">
            <button type="button" class="@(ToolClass("select"))" title="Select" aria-label="Select" @onclick="SelectTool">
                <svg class="tool-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 3.5 18.5 13l-6.1 1.2-3.2 5.3L5 3.5Z" />
                </svg>
                <span class="sr-only">Select</span>
            </button>
            <button type="button" disabled="@ReadOnlyMode" class="@(ToolClass("constraint"))" title="Constraint line" aria-label="Constraint line" @onclick="ConstraintTool">
                <svg class="tool-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="5" cy="18" r="2" /><circle cx="19" cy="6" r="2" /><path d="m6.5 16.7 11-9.4" />
                </svg>
                <span class="sr-only">Constraint line</span>
            </button>
            <button type="button" disabled="@ReadOnlyMode" class="@(ToolClass("polyline"))" title="Polyline" aria-label="Polyline" @onclick="PolylineTool">
                <svg class="tool-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m4 17 5-9 5 7 6-9" /><circle cx="4" cy="17" r="1.7" /><circle cx="9" cy="8" r="1.7" /><circle cx="14" cy="15" r="1.7" /><circle cx="20" cy="6" r="1.7" />
                </svg>
                <span class="sr-only">Polyline</span>
            </button>
            <button type="button" disabled="@ReadOnlyMode" class="@(ToolClass("polygon"))" title="Polygon" aria-label="Polygon" @onclick="PolygonTool">
                <svg class="tool-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m12 3 8 6-3 10H7L4 9l8-6Z" /><circle cx="12" cy="3" r="1.4" /><circle cx="20" cy="9" r="1.4" /><circle cx="17" cy="19" r="1.4" /><circle cx="7" cy="19" r="1.4" /><circle cx="4" cy="9" r="1.4" />
                </svg>
                <span class="sr-only">Polygon</span>
            </button>
            @if (_tool == "constraint")
            {
                <p>Choose two nodes. Cmd+click empty space to insert an endpoint first.</p>
            }
            else if (_tool == "polyline")
            {
                <p>Choose ordered nodes. Cmd+click inserts an endpoint. Enter finishes; Escape cancels.</p>
            }
            else if (_tool == "polygon")
            {
                <p>Choose at least three ordered vertices. Enter closes the polygon; Escape cancels.</p>
            }
            <div class="face-legend" aria-label="Face classification colors">
                <span title="Land"><i class="land-swatch"></i><span class="sr-only">Land</span></span>
                <span title="Lake"><i class="lake-swatch"></i><span class="sr-only">Lake</span></span>
            </div>
        </aside>
        <section class="viewport-frame" aria-label="Interactive 2D mesh viewport">
            <canvas @ref="_canvas" tabindex="0">
                Your browser does not support the canvas element.
            </canvas>
        </section>
        <aside class="properties-panel" aria-label="Selected object properties">
            <h2>Properties</h2>
            <section class="property-card">
                <span class="property-type">Mesh</span>
                <h3>Summary</h3>
                <dl>
                    <div><dt>Nodes</dt><dd>@_nodeCount</dd></div>
                    <div><dt>Edges</dt><dd>@_edgeCount</dd></div>
                    <div><dt>Constraints</dt><dd>@_constraintCount</dd></div>
                </dl>
            </section>
            @if (_selectedObjects.Count == 0)
            {
                <p class="empty-properties">@(_selection == "No selection"
                    ? "Select a node, edge, face, or constraint."
                    : _selection)</p>
            }
            else
            {
                @foreach (SelectionInfo item in _selectedObjects)
                {
                    <section class="property-card">
                        <span class="property-type">@item.Type</span>
                        <h3>@item.Title</h3>
                        <dl>
                            @foreach (SelectionProperty property in item.Properties)
                            {
                                <div>
                                    <dt>@property.Name</dt>
                                    <dd>
                                        @if (IsEditableNodeProperty(item, property))
                                        {
                                            <input type="number"
                                                   step="any"
                                                   min="@(property.Name == "Target area" ? "0" : null)"
                                                   value="@(property.Value == "Varies" ? null : property.Value)"
                                                   placeholder="@(property.Value == "Varies" ? "Varies" : null)"
                                                   aria-label="@property.Name"
                                                   @onchange="args => UpdateNodeProperty(item, property.Name, args.Value?.ToString())" />
                                        }
                                        else
                                        {
                                            @property.Value
                                        }
                                    </dd>
                                </div>
                            }
                        </dl>
                    </section>
                }
            }
        </aside>
    </section>

    <footer class="statusbar">
        @if (_view3D)
        {
            <span class="mode-status"><strong>3D ELEVATION</strong> Read-only <i></i> Left-drag: orbit <i></i> Middle-drag: pan <i></i> Wheel: zoom</span>
        }
        else if (_quadMode)
        {
            <span class="mode-status"><strong>QUAD REPRESENTATION</strong> Read-only <i></i> Click: select <i></i> Middle-drag: pan</span>
        }
        else
        {
            <span>Click: select <i></i> Double-click: select same kind <i></i> Shift: add <i></i> Ctrl: segment/toggle <i></i> Cmd+click: insert <i></i> Middle-drag: pan</span>
        }
        <output class="coordinates">X @_x.ToString("0.00").PadLeft(7) &nbsp; Y @_y.ToString("0.00").PadLeft(7)</output>
        <output class="zoom">@_selection &nbsp; @_nodeCount nodes &nbsp; @(_zoom.ToString("0"))%</output>
    </footer>
</main>

@code {
    ElementReference _canvas;
    IJSObjectReference? _module;
    DotNetObjectReference<Home>? _self;
    double _x;
    double _y;
    double _zoom = 100;
    int _nodeCount = 11;
    string _selection = "No selection";
    bool _showSuperStructure = true;
    int _edgeCount;
    int _constraintCount;
    bool _canUndo;
    bool _canRedo;
    bool _quadMode;
    bool _view3D;
    bool ReadOnlyMode => _quadMode || _view3D;
    bool _refineLand = true;
    bool _refineLakes;
    string _tool = "select";
    IReadOnlyList<SelectionInfo> _selectedObjects = [];
    readonly EditorMeshModel _mesh = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/mesh-editor.js");
        _self = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("initialize", _canvas, _self, _mesh.State());
    }

    async Task Reset() => await InvokeEditor("reset");
    async Task Fit() => await InvokeEditor("fit");
    async Task ResetMesh() => await InvokeEditor("resetMesh");
    async Task Undo() => await InvokeEditor("undo");
    async Task Redo() => await InvokeEditor("redo");
    async Task RefineSelectedFaces()
    {
        if (_module is not null)
            await _module.InvokeVoidAsync(
                "refineSelectedFaces", _canvas, _refineLand, _refineLakes);
    }

    async Task ToggleQuadMesh()
    {
        if (_module is null) return;
        if (_view3D)
        {
            _view3D = false;
            await _module.InvokeVoidAsync("hide3DView", _canvas);
        }
        _quadMode = !_quadMode;
        _tool = "select";
        if (_quadMode)
            await _module.InvokeVoidAsync("showQuadMesh", _canvas, _mesh.QuadState());
        else
            await _module.InvokeVoidAsync("hideQuadMesh", _canvas);
    }

    async Task Toggle3DView()
    {
        if (_module is null) return;
        if (_quadMode)
        {
            _quadMode = false;
            await _module.InvokeVoidAsync("hideQuadMesh", _canvas);
        }
        _view3D = !_view3D;
        _tool = "select";
        await _module.InvokeVoidAsync(_view3D ? "show3DView" : "hide3DView", _canvas);
    }

    async Task SetTool(string tool)
    {
        _tool = tool;
        if (_module is not null) await _module.InvokeVoidAsync("setToolMode", _canvas, tool);
    }

    Task SelectTool() => SetTool("select");
    Task ConstraintTool() => SetTool("constraint");
    Task PolylineTool() => SetTool("polyline");
    Task PolygonTool() => SetTool("polygon");

    string ToolClass(string tool) => _tool == tool ? "tool active" : "tool";

    bool IsEditableNodeProperty(SelectionInfo item, SelectionProperty property)
        => !ReadOnlyMode && item.Type == "Node" && item.Ids.Count > 0 &&
           property.Name is "Elevation" or "Target area" &&
           item.Properties.Any(value => value is { Name: "Super structure", Value: "No" });

    async Task UpdateNodeProperty(SelectionInfo item, string propertyName, string? value)
    {
        if (_module is null || item.Ids.Count == 0 ||
            !double.TryParse(value, System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out double changed)) return;
        await _module.InvokeVoidAsync(
            "updateSelectedNodeProperty", _canvas, item.Ids, propertyName, changed);
    }

    async Task ToggleSuperStructure(ChangeEventArgs args)
    {
        _showSuperStructure = args.Value is true;
        if (_module is not null)
            await _module.InvokeVoidAsync("setSuperStructureVisibility", _canvas, _showSuperStructure);
    }

    async Task InvokeEditor(string method)
    {
        if (_module is not null) await _module.InvokeVoidAsync(method, _canvas);
    }

    [JSInvokable]
    public Task UpdateStatus(
        double x,
        double y,
        double zoom,
        int nodeCount,
        int edgeCount,
        int constraintCount,
        string selection,
        bool canUndo,
        bool canRedo,
        SelectionInfo[] selectedObjects)
    {
        _x = x;
        _y = y;
        _zoom = zoom * 100;
        _nodeCount = nodeCount;
        _edgeCount = edgeCount;
        _constraintCount = constraintCount;
        _selection = selection;
        _canUndo = canUndo;
        _canRedo = canRedo;
        _selectedObjects = selectedObjects;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public MeshView InsertNode(double x, double y) => ReadOnlyMode ? _mesh.State() : _mesh.Insert(x, y);

    [JSInvokable]
    public ElementHit? FindElement(double x, double y, double tolerance)
        => _mesh.Find(x, y, tolerance);

    [JSInvokable]
    public MeshView RemoveNode(int nodeId) => ReadOnlyMode ? _mesh.State() : _mesh.Remove(nodeId);

    [JSInvokable]
    public MeshView UpdateNodeData(int nodeId, double elevation, double targetArea)
        => ReadOnlyMode ? _mesh.State() : _mesh.UpdateNodeData(nodeId, elevation, targetArea);

    [JSInvokable]
    public MeshView UpdateNodeProperty(int[] nodeIds, string propertyName, double value)
        => ReadOnlyMode ? _mesh.State() : _mesh.UpdateNodeProperty(nodeIds, propertyName, value);

    [JSInvokable]
    public MeshView RefineFaces(int[] faceIds, bool refineLand, bool refineLakes)
        => ReadOnlyMode ? _mesh.State() : _mesh.RefineFaces(faceIds, refineLand, refineLakes);

    [JSInvokable]
    public MeshView RefineAll(bool refineLand, bool refineLakes)
        => ReadOnlyMode ? _mesh.State() : _mesh.RefineAll(refineLand, refineLakes);

    [JSInvokable]
    public MeshView ResetMeshState() => ReadOnlyMode ? _mesh.State() : _mesh.Reset();

    [JSInvokable]
    public MeshView UndoAction() => ReadOnlyMode ? _mesh.State() : _mesh.Undo();

    [JSInvokable]
    public MeshView RedoAction() => ReadOnlyMode ? _mesh.State() : _mesh.Redo();

    [JSInvokable]
    public Task SelectDefaultTool()
    {
        _tool = "select";
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public MeshView InsertConstraintLine(int fromId, int toId)
        => ReadOnlyMode ? _mesh.State() : _mesh.InsertConstraint(fromId, toId);

    [JSInvokable]
    public MeshView InsertPolyline(int[] nodeIds)
        => ReadOnlyMode ? _mesh.State() : _mesh.InsertPolyline(nodeIds);

    [JSInvokable]
    public MeshView InsertPolygon(int[] nodeIds)
        => ReadOnlyMode ? _mesh.State() : _mesh.InsertPolygon(nodeIds);

    [JSInvokable]
    public IReadOnlyList<EdgeView> CollectConstraintLine(int startId, int endId)
        => _mesh.CollectConstraintLine(startId, endId);

    [JSInvokable]
    public IReadOnlyList<EdgeView> CollectConstraint(int constraintId)
        => _mesh.CollectConstraint(constraintId);

    [JSInvokable]
    public MeshView RemoveConstraintLine(int constraintId)
        => ReadOnlyMode ? _mesh.State() : _mesh.RemoveConstraint(constraintId);

    [JSInvokable]
    public MeshView RemoveElements(int[] constraintIds, int[] nodeIds)
        => ReadOnlyMode ? _mesh.State() : _mesh.RemoveElements(constraintIds, nodeIds);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _canvas); }
            catch (JSDisconnectedException) { }
            await _module.DisposeAsync();
        }
        _self?.Dispose();
    }
}
